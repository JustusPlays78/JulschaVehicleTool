<Window x:Class="JulschaVehicleTool.App.Views.ImportPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Vehicles"
        Width="760" Height="620" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource OnSurfaceBrush}">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="SubHeaderText" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
        </StackPanel>

        <!-- Vehicles -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="VehicleList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="6"
                                Background="{DynamicResource SurfaceVariantBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" VerticalContentAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource OnSurfaceBrush}" />
                                </CheckBox>
                                <TextBlock Text="{Binding FilesSummary}" FontSize="12" Margin="24,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                <TextBlock Text="{Binding MetaSummary}" FontSize="12" Margin="24,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                <ItemsControl ItemsSource="{Binding Notes}" Margin="24,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='⚠ {0}'}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource WarningBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Warnings / unassigned files -->
        <Expander x:Name="WarningsExpander" Grid.Row="2" Margin="0,8,0,0"
                  Foreground="{DynamicResource OnSurfaceBrush}">
            <TextBox x:Name="WarningsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                     Background="{DynamicResource SurfaceVariantBrush}"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}"
                     BorderThickness="0" Padding="8" />
        </Expander>

        <!-- Buttons -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="TargetText" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
            <Button DockPanel.Dock="Right" x:Name="ImportButton" Content="Import"
                    Background="{DynamicResource AccentBrush}" Foreground="White"
                    Padding="24,8" Click="OnImport" />
            <Button DockPanel.Dock="Right" Content="Cancel"
                    Foreground="{DynamicResource OnSurfaceVariantBrush}"
                    Margin="0,0,8,0" Padding="16,8" Click="OnCancel" />
        </DockPanel>
    </Grid>
</Window>
